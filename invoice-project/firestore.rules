rules_version = '2';

// Per-user Firestore security rules for the Koalvia invoice app.
//
// Every document lives under `users/{uid}/...` and is private to that user.
// A request is only allowed when it is authenticated and the `uid` in the
// path matches the signed-in user. Everything outside a user's own tree
// (other users' trees and any root-level collection) is denied by default,
// because no other `match` grants access.
//
// The `{document=**}` recursive wildcard means future per-user collections
// (e.g. settings/company, meta/invoiceCounter, a later invoices collection)
// are covered without a rules rewrite.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
